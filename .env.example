# Copy this file to .env and adjust as needed. All variables have working
# defaults baked into docker-compose.yml, so `docker compose up --build`
# works out of the box even without a .env file — this is only needed to
# override those defaults (e.g. before exposing the stack beyond localhost).

# Postgres
POSTGRES_DB=plantpulse
POSTGRES_USER=plantpulse
POSTGRES_PASSWORD=change-me

# Backend — HMAC key for signing JWTs, at least 32 bytes.
PLANTPULSE_JWT_SECRET=change-me-to-a-long-random-string

# Host ports (optional overrides)
BACKEND_PORT=8080
FRONTEND_PORT=8081
